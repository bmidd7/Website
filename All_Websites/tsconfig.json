{
  "compilerOptions": {
    "rootDir": "./static/ts",
    "outDir": "./static/js",
    "target": "ES2020",
    "sourceMap": true,
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./static/ts/**/*.ts"]
}
