function toggleVerificationPin(e) 
{
	var isHidden = $(e).attr('data-hidden');
	var supportPin = $(e).attr('data-pin');

	if(isHidden == 'yes')
	{
		$('.supportPin').html(supportPin);
		$('.togglePin').attr('data-hidden', 'no');
		$('.togglePin').html('hide');
	}
	else if(isHidden == 'no')
	{
		$('.supportPin').html("●".repeat(supportPin.length));
		$('.togglePin').attr('data-hidden', 'yes');
		$('.togglePin').html('show');
	}

	event.stopPropagation();
}

function reopenCookieBanner()
{
	$('#pbUserPrefs').show();
}

// Fallback when support is opted out — overridden by support-widget.js when support is enabled
function toggleSupportWidget()
{
	var popover = document.getElementById('supportOptedOutPopover');
	if(popover)
		popover.classList.toggle('visible');
}

// Called by the consent banner: saves both marketing and support preferences at once.
// Pass explicit true/false for Accept All / Opt Out All; call with no args for Save Choices.
function cookieBannerSave(allowMarketing, allowSupport)
{
	if(typeof allowMarketing === 'undefined')
		allowMarketing = $('#cookieConsent_marketing').prop('checked');
	if(typeof allowSupport === 'undefined')
		allowSupport = $('#cookieConsent_support').prop('checked');

	$('#cookieConsent_marketing').prop('checked', allowMarketing);
	$('#cookieConsent_support').prop('checked', allowSupport);

	$('.pbPrefsBtn').hide();
	$('#pbPrefsLoading').show();

	$.post("/api/user/cookiePrivacySave", {
		marketing: allowMarketing ? 'off' : 'on',
		support:   allowSupport   ? 'off' : 'on'
	},
	function(data)
	{
		if(data['error'] == '1')
		{
			alert(data['message']);
			$('.pbPrefsBtn').show();
			$('#pbPrefsLoading').hide();
		}
		else
		{
			$('#accountPrivacySetting_optionalCookies').prop('checked', allowMarketing);
			$('#accountPrivacySetting_support').prop('checked', allowSupport);
			window.location.reload();
		}
	}, 'json');
}

function cookieSupportOptOut()
{
	$.post("/api/user/cookieSupportOptOut", {post:1},
	function(data)
	{
		if(data['error'] == '1')
			alert(data['message']);
		else
			window.location.reload();
	}, 'json');
}

function cookieSupportOptIn()
{
	$.post("/api/user/cookieSupportOptIn", {post:1},
	function(data)
	{
		if(data['error'] == '1')
			alert(data['message']);
		else
			window.location.reload();
	}, 'json');
}

function cookiePrivacyOptOut()
{
        $('.pbPrefsBtn').hide();
        $('#pbPrefsLoading').show();

        $.post("/api/user/cookiePrivacyOptOut", {post:1},
        function(data)
        {
                if(data['error'] == '1')
                {
                        alert(data['message']);

                        $('.pbPrefsBtn').show();
                        $('#pbPrefsLoading').hide();
                }
                else
                {
                        window.location.reload();
                }
        }, 'json');
}

function cookiePrivacyOptIn()
{
        $('.pbPrefsBtn').hide();
        $('#pbPrefsLoading').show();

        $.post("/api/user/cookiePrivacyOptIn", {post:1},
        function(data)
        {
                if(data['error'] == '1')
                {
                        alert(data['message']);

                        $('.pbPrefsBtn').show();
                        $('#pbPrefsLoading').hide();
                }
                else
                {
                        window.location.reload();
                }
        }, 'json');
}

function showExternalSiteMessage(e, partnerSiteName)
{
        var redirect = jQuery.trim($(e).attr('data-href'));
	var modalId = 'messageModal';
        showMessageModal("External Site Notice", "By continuing we will redirect you to an external partner site, "+partnerSiteName+".<br><br><br><center><a class='btn btn-lg btn-porkbun' onclick='closeExternalSiteMessage(\""+modalId+"\");' href='"+redirect+"' target='_blank'>Continue</a></center>", false, "No Thanks");
}

function closeExternalSiteMessage(modalId)
{
	$("#"+modalId).modal("hide");
}

function viewDomainDNS(domain, e)
{
    // New drawer UI — default unless flag is explicitly 'modal'
    if (localStorage.getItem('dns_ui_mode') !== 'modal' && typeof openDnsDrawer === 'function') {
        openDnsDrawer(domain);
        return;
    }

    $("#quickDnsAlert").hide();
    $("#quickDnsAlertContent").html('');
    $('#editDNSModalCloudflareBadge').hide();
    $('#editDnsNsConfigure').hide();
    $('#editDNSModal_loading').hide();
    $('#editDNSModal_contentLoading').show();
    $('#editDNSModal_button').show();
    $('#editDNSModalContainer').html('');
    $('#editDNSModalAlert').hide();
    $('#editDNSModalAlert').html('');
    $('#editDNSModal').attr('data-domain', domain);
