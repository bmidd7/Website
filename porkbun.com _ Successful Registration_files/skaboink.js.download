	var type = jQuery.trim($(e).attr('data-type'));

	$('.attrDynamic').attr('data-domain', domain);
	$('#addOnHosting').modal('hide');

	if(type == 'cloudWordPress')
	{
		$('#addOnHosting_cloudWordPress').modal('show');
