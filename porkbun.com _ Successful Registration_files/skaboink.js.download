function processBuyAccountCreditAch()
{
	var amount = jQuery.trim($('#modal_buyAccountCreditAch_amount').val());

	$("#modal_buyAccountCreditAch_loading").show();
	$("#modal_buyAccountCreditAch_buttons").hide();

    $.post("/api/user/buyAccountCreditAch", {amount:amount},
    function(data)
    {
        if(data['error'] == '1')
        {
		alert(data['message']);

		$("#modal_buyAccountCreditAch_loading").hide();
		$("#modal_buyAccountCreditAch_buttons").show();
        }
        else
        {
		if(data['client_secret'] && data['name'] && data['email'])
		{
  stripe.confirmUsBankAccountPayment(data['client_secret'])
  .then(({paymentIntent, error}) => {
    if (error) {
	alert(error.message);
	$("#modal_buyAccountCreditAch_loading").hide();
	$("#modal_buyAccountCreditAch_buttons").show();
      console.error(error.message);
      // The payment failed for some reason.
    } else if (paymentIntent.status === "requires_payment_method") {
	alert("Confirmation failed.");
	$("#modal_buyAccountCreditAch_loading").hide();
	$("#modal_buyAccountCreditAch_buttons").show();
      // Confirmation failed. Attempt again with a different payment method.
    } else if (paymentIntent.status === "processing") {
	alert("The ACH request has been submitted. We will notify you via email after the transaction has been completed and your account has been credited. Please note that this process can take up to 7 days.");
	$('#modal_buyAccountCreditAch').modal('hide');
	$("#modal_buyAccountCreditAch_loading").hide();
	$("#modal_buyAccountCreditAch_buttons").show();
      // Confirmation succeeded! The account will be debited.
      // Display a message to customer.
    } else if (paymentIntent.next_action?.type === "verify_with_microdeposits") {
	alert("Confirmation failed, microdeposits need verified.");
	$("#modal_buyAccountCreditAch_loading").hide();
	$("#modal_buyAccountCreditAch_buttons").show();
      // The account needs to be verified through microdeposits.
      // Display a message to consumer with next steps (consumer waits for
      // microdeposits, then enters a statement descriptor code on a page sent to them through email).
    }
  });
		}
		else
		{
			alert("Invalid response from server.");
		}
        }
    }, "json");
}

