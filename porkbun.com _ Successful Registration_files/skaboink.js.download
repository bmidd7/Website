	else if(action == 'marketplace' || action == 'afternic' || action == 'registration' || action == 'preorder' || action == 'sedo' || action == 'atom' || action == 'namebright')
	{
		var allocationToken = jQuery.trim($(e).attr('data-allocation-token'));

