function setupAchAcceptMandate()
{
	$('#modal_updateAch_mandate_buttons').hide();
	$('#modal_updateAch_mandate_loading').show();

	var clientSecret = $('#modal_updateAch_mandate_buttons_accept').attr('data-clientSecret');

  stripe.confirmUsBankAccountSetup(clientSecret)
  .then(({setupIntent, error}) => {
    if (error) {
	$('#modal_updateAch_mandate_buttons').hide();
	$('#modal_updateAch_mandate_loading').show();

	alert(error.message);
      console.error(error.message);
      // The payment failed for some reason.
    } else if (setupIntent.status === "requires_payment_method") {
	$('#modal_updateAch_mandate_buttons').hide();
	$('#modal_updateAch_mandate_loading').show();

	alert("Confirmation failed.");
      // Confirmation failed. Attempt again with a different payment method.
    } else if (setupIntent.status === "succeeded") {
	console.log(setupIntent);

	    $.post("/api/user/setupAchForAccount", {paymentMethod:setupIntent['payment_method'], status:'verified'},
	    function(data)
	    {
	        if(data['error'] == '1')
        	{
			$('#modal_updateAch_mandate_buttons').show();
			$('#modal_updateAch_mandate_loading').hide();

			alert(data['message']);
	        }
        	else
	        {
			window.location.reload();
	        }
	    }, "json");

      // Confirmation succeeded! The account is now saved.
      // Display a message to customer.
    } else if (setupIntent.next_action.type === "verify_with_microdeposits") {
	console.log(setupIntent);

	    $.post("/api/user/setupAchForAccount", {paymentMethod:setupIntent['payment_method'], status:'new', 'verify_with_microdeposits':setupIntent['next_action']['verify_with_microdeposits']},
	    function(data)
	    {
	        if(data['error'] == '1')
        	{
			$('#modal_updateAch_mandate_buttons').show();
			$('#modal_updateAch_mandate_loading').hide();

			alert(data['message']);
	        }
        	else
	        {
			alert("Manual confirmation is required. Please see message on next screen for further instructions.");
			window.location.reload();
	        }
	    }, "json");
      // The account needs to be verified through microdeposits.
      // Display a message to consumer with next steps (consumer waits for
      // microdeposits, then enters a statement descriptor code on a page sent to them through email).
    }
  });
}

function setupAchConfiguration()
{
	$("#modal_updateAch_loading").show();
	$("#modal_updateAch_buttons").hide();
	
	var accountHolderName = jQuery.trim($("#modal_updateAch_accountHolderName").val());

	if(!accountHolderName)
	{
		alert("You must supply the account holder's name.");
		return;
	}

    $.post("/api/user/setupAchIntent", {post:1},
    function(data)
    {
        if(data['error'] == '1')
        {
		$("#modal_updateAch_loading").hide();
		$("#modal_updateAch_buttons").show();

		alert(data['message']);
        }
        else
        {
  stripe.collectBankAccountForSetup({
    clientSecret: data['client_secret'],
    params: {
      payment_method_type: 'us_bank_account',
      payment_method_data: {
        billing_details: {
          name: accountHolderName,
          email: data['email'],
        },
      },
    },
    expand: ['payment_method'],
  })
  .then(({setupIntent, error}) => {
    if (error) {
      alert(error.message);
      console.error(error.message);

		$("#modal_updateAch_loading").hide();
		$("#modal_updateAch_buttons").show();
      // PaymentMethod collection failed for some reason.
    } else if (setupIntent.status === 'requires_payment_method') {
	alert("It looks like you canceled the ACH onboarding process, please try again.");

		$("#modal_updateAch_loading").hide();
		$("#modal_updateAch_buttons").show();
      // Customer canceled the hosted verification modal. Present them with other
      // payment method type options.
    } else if (setupIntent.status === 'requires_confirmation') {
      // We collected an account - possibly instantly verified, but possibly
      // manually-entered. Display payment method details and mandate text
      // to the customer and confirm the intent once they accept
      // the mandate.

      console.log(setupIntent);

		$("#modal_updateAch_loading").hide();
		$("#modal_updateAch_buttons").show();

      $('#modal_updateAch_mandate_buttons_accept').attr('data-clientSecret', setupIntent['client_secret']);
      $('#modal_updateAch_initial').hide();
      $('#modal_updateAch_footer').hide();
      $('#modal_updateAch_mandate').show();
    }
  });
        }
    }, "json");
}

