			var maxPerUser = '';
			var idn = '';
			var truenameCount = 0;
			var afternicCount = 0;
			var exactMatchAfternicCount = 0;
			var exactMatchTruenameCount = 0;
			var marketplaceCount = 0;
			var daxauctionCount = 0;
			var exactMatchMarketplaceCount = 0;
			var exactMatchDaxauctionCount = 0;
			var haveAftermarket = false;
