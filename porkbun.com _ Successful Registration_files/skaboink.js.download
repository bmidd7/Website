    $('.editDNSModal_domain').html(domain);
    $('.editDNSModal_dataDomain').attr('data-domain', domain);
    $('#editDNSModal_existingRecordsContainer').show();

    $('#editDNSModal_host').val('');
    $('#editDNSModal_answer').val('');


    $('#editDNSModalContainer').html(
'\
