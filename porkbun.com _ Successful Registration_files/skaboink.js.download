<i data-name="priority" data-order="asc"  class="dnsSortIcon fas fa-sort-numeric-down" style="display:none;"></i>\
<i data-name="priority" data-order="desc" class="dnsSortIcon fas fa-sort-numeric-up"  style="display:none;"></i>\
