		else
		{
			$('#editApiSettingsModal_button').attr('data-id', id);

			$('#editApiSettingsModal_title').val(htmlentities(data['title']));
			$('#editApiSettingsModal_redirectUrl').val(htmlentities(data['redirectUrl']));
